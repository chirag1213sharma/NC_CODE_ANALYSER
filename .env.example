# NC Code Analyser Configuration
# Copy this file to .env and fill in your values

# Gemini AI Configuration
GEMINI_API_KEY=

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nc_analyser
DATABASE_URL_SYNC=postgresql://postgres:password@localhost:5432/nc_analyser

# Application Settings
APP_NAME=NC Code Analyser
APP_VERSION=v1.50
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# File Storage
UPLOAD_DIR=./data/uploads
BASELINE_DIR=./data/baselines
REPORTS_DIR=./data/reports
